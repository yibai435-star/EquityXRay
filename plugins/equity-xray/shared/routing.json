{
  "schema_version": 1,
  "modules": [
    {
      "name": "financial-statement-analysis",
      "intent": "initial_multi_year_financial_report_or_explicit_metric_deep_dive",
      "modes": [
        "full",
        "quick",
        "deep"
      ],
      "status": "implemented"
    },
    {
      "name": "earnings-analysis",
      "intent": "quarterly_results",
      "modes": [
        "earnings"
      ],
      "status": "workflow_scaffold"
    },
    {
      "name": "comps-analysis",
      "intent": "peer_operating_or_valuation_comparison",
      "modes": [
        "operating",
        "valuation"
      ],
      "status": "workflow_scaffold"
    },
    {
      "name": "dcf-valuation",
      "intent": "discounted_cashflow_valuation",
      "modes": [
        "dcf"
      ],
      "status": "workflow_scaffold"
    },
    {
      "name": "model-update",
      "intent": "existing_model_revision",
      "modes": [
        "update"
      ],
      "status": "workflow_scaffold"
    }
  ],
  "priority": [
    "explicit_user_sequence",
    "existing_model_revision",
    "peer_comparison",
    "dcf_valuation",
    "quarterly_results",
    "financial_health"
  ],
  "unknown": "clarify_after_useful_work",
  "semantic_router": "Interpret intent, negation, context and authorized scope; script is a bounded regression helper, not the semantic authority. Main financial reports may contain internal peer or earnings tasks without changing the deliverable.",
  "regression_rules": [
    {
      "skill": "model-update",
      "mode": "update",
      "pattern": "(更新|修订|修改).*(模型|预测|model)|update.*model"
    },
    {
      "skill": "comps-analysis",
      "mode": "operating",
      "pattern": "(对比|比较|vs|经营模式差异|谁的经营模式|同行估值|comps)",
      "mode_overrides": [
        {
          "pattern": "估值|倍数|multiple",
          "mode": "valuation"
        }
      ]
    },
    {
      "skill": "dcf-valuation",
      "mode": "dcf",
      "pattern": "DCF|贴现现金流|现金流折现|做.*估值|估值.*公司"
    },
    {
      "skill": "earnings-analysis",
      "mode": "earnings",
      "pattern": "最新季度|季度业绩|Q[1-4].*(发布|分析|业绩)|季报点评"
    },
    {
      "skill": "financial-statement-analysis",
      "mode": "full",
      "pattern": "分析|财报|财务质量|三张表|三表|深挖|过去.*年|财务体检|财报体检|财务分析|财报分析",
      "mode_overrides": [
        {
          "pattern": "深挖",
          "mode": "deep"
        },
        {
          "pattern": "快速",
          "mode": "quick"
        }
      ]
    }
  ],
  "main_report_pattern": "财报分析报告|财务分析报告|财务体检|财报体检|过去.*年.*财报|近.*年.*财务",
  "sequence_pattern": "然后|接着|再(?=给|做|分析|更新|比较|对比)|(?:并且?|同时|以及|和)(?=(?:单独|独立|比较|对比|分析)|(?:给.{0,20}做|做.{0,20})(?:DCF|估值)|更新.{0,20}模型)",
  "negative_clause_pattern": "^\\s*(?:先|暂时|也)?(?:不要|不用|不需要|无需|不做|别)",
  "embedded_support": [
    {
      "skill": "comps-analysis",
      "mode": "operating",
      "pattern": "同行|毛利率|资产周转",
      "role": "peer_metrics",
      "invocation": "when_needed"
    },
    {
      "skill": "earnings-analysis",
      "mode": "earnings",
      "pattern": "补充.*(?:季度|Q[1-4])|最新季度|季度业绩",
      "role": "quarterly_supplement",
      "invocation": "when_needed"
    }
  ],
  "main_report_with_support_pattern": "(?:分析|做|生成).{0,30}(?:财报|财务|三张表).*(?:补充|附带|参考|结合|顺便).*(?:季度|Q[1-4]|同行)"
}
